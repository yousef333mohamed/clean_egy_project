# Placeholders only. Inject secret values with your platform secret manager.
APP_ENVIRONMENT=production
APP_RELEASE_VERSION=<release-version>
APP_COMMIT_SHA=<commit-sha>
APP_BUILD_TIME=<rfc3339-time>
LOG_LEVEL=INFO
AUTH_ENABLED=true
AUTH_PROVIDER=oidc
OIDC_ISSUER_URL=https://identity.example.com/realms/wasteops
OIDC_JWKS_URL=https://identity.example.com/realms/wasteops/protocol/openid-connect/certs
OIDC_AUDIENCE=wasteops-api
OIDC_CLIENT_ID=wasteops-web
OIDC_ROLE_CLAIM=roles
OIDC_PERMISSION_CLAIM=permissions
JWT_ALLOWED_ALGORITHMS=RS256
JWT_CLOCK_SKEW_SECONDS=60
JWKS_CACHE_TTL_SECONDS=3600
JWKS_REQUEST_TIMEOUT_SECONDS=10
ALLOW_DEVELOPMENT_AUTH=false
AUTH_SECRET=<secret-manager-reference>
OIDC_CLIENT_SECRET=<secret-manager-reference>
AUTH_TRUST_HOST=true
AUTH_URL=https://wasteops.example.com
BACKEND_INTERNAL_URL=http://backend:8000
CORS_ALLOWED_ORIGINS=https://wasteops.example.com
TRUSTED_HOSTS=wasteops.example.com
DATABASE_URL=<secret-manager-reference>
DATABASE_SYNC_URL=<migration-secret-manager-reference>
REDIS_URL=<secret-manager-reference>
REDIS_REQUIRED=true
RATE_LIMIT_ENABLED=true
METRICS_TOKEN=<secret-manager-reference>
LLM_API_KEY=<secret-manager-reference>
ENABLE_RETRIEVAL_DEBUG_API=false
ANALYTICS_ENABLE_DEBUG_API=false
ENABLE_DECISION_DEBUG_API=false
DECISION_REQUIRE_HUMAN_APPROVAL=true
ALLOW_MOCK_DATA_SCIENCE=false
DATA_SCIENCE_PROVIDER=remote
ML_SERVICE_BASE_URL=http://ml_service:8001
ML_SERVICE_TOKEN=<secret-manager-reference>
ML_ADMIN_SERVICE_TOKEN=<secret-manager-reference>
ML_ANALYTICS_DATABASE_URL=<read-only-database-secret-reference>
MLFLOW_DATABASE_URL=<mlflow-metadata-database-secret-reference>
MLFLOW_ARTIFACT_BUCKET=<private-artifact-bucket>
OBJECT_STORAGE_ENDPOINT_URL=<private-s3-compatible-endpoint>
ALLOWED_MODEL_CHECKSUMS=<comma-separated-approved-sha256-values>
OBJECT_STORAGE_BACKEND=s3
OBJECT_STORAGE_BUCKET=<private-bucket>
OBJECT_STORAGE_REGION=<region>
BACKGROUND_JOBS_ENABLED=true
BACKUP_RETENTION_DAYS=30
BACKUP_DIRECTORY=/backups
BACKUP_ENCRYPTION_ENABLED=true
TRACE_RETENTION_DAYS=30
EVALUATION_RESULT_RETENTION_DAYS=365
AUDIT_LOG_RETENTION_DAYS=730
FEEDBACK_RETENTION_DAYS=365
FAILED_JOB_RETENTION_DAYS=90
NEXT_PUBLIC_APP_NAME=WasteOps Decision Intelligence Copilot
NEXT_PUBLIC_API_BASE_URL=https://wasteops.example.com
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_AUTH_ENABLED=true
NEXT_PUBLIC_ENABLE_ADMIN_PAGES=true
NEXT_PUBLIC_ENABLE_INGESTION_PAGES=true
NEXT_PUBLIC_ENABLE_EVALUATION_PAGES=true
NEXT_PUBLIC_ENABLE_PROMPT_PAGES=true
NEXT_PUBLIC_DEFAULT_LANGUAGE=en
NEXT_PUBLIC_DEFAULT_TIMEZONE=Africa/Cairo
