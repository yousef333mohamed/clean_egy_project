APP_ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://wasteops:wasteops@database:5432/wasteops
DATABASE_SYNC_URL=postgresql+psycopg://wasteops:wasteops@database:5432/wasteops
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_RECYCLE_SECONDS=1800
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
CHAT_MODEL_NAME=gpt-4.1-mini
EMBEDDING_MODEL_NAME=text-embedding-3-small
VECTOR_DIMENSIONS=1536
RETRIEVAL_TOP_K=8
SQL_QUERY_TIMEOUT_MS=5000
SQL_ROW_LIMIT=200
DATA_DIR=data
CSV_BATCH_SIZE=5000
SOURCE_TIMEZONE=Africa/Cairo
INGESTION_STRICT_COLUMNS=false
ENABLE_INGESTION_API=true
