APP_ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://wasteops:wasteops@database:5432/wasteops
DATABASE_SYNC_URL=postgresql+psycopg://wasteops:wasteops@database:5432/wasteops
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_RECYCLE_SECONDS=1800
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
CHAT_MODEL_NAME=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
RETRIEVAL_TOP_K=8
RETRIEVAL_CANDIDATE_LIMIT=30
RETRIEVAL_MIN_SCORE=0.45
RETRIEVAL_VECTOR_WEIGHT=0.75
RETRIEVAL_KEYWORD_WEIGHT=0.25
RETRIEVAL_MAX_CONTEXT_TOKENS=5000
RETRIEVAL_MAX_CHUNKS_PER_DOCUMENT=3
RETRIEVAL_MAX_QUERY_CHARS=4000
RETRIEVAL_ENABLE_QUERY_REWRITE=true
RETRIEVAL_ENABLE_HYBRID=true
RETRIEVAL_ENABLE_RERANKING=true
RETRIEVAL_ALLOW_PRODUCTION_CONTENT=false
LLM_TEMPERATURE=0.1
LLM_MAX_OUTPUT_TOKENS=1200
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=3
ENABLE_CHAT_API=true
ENABLE_RETRIEVAL_DEBUG_API=true
SQL_QUERY_TIMEOUT_MS=5000
SQL_ROW_LIMIT=200
DATA_DIR=data
CSV_BATCH_SIZE=5000
SOURCE_TIMEZONE=Africa/Cairo
INGESTION_STRICT_COLUMNS=false
ENABLE_INGESTION_API=true
DOCUMENTS_DIRECTORY=data/documents
DOCUMENT_CHUNK_SIZE=700
DOCUMENT_CHUNK_OVERLAP=120
DOCUMENT_MIN_CHUNK_SIZE=80
DOCUMENT_MAX_FILE_SIZE_MB=25
DOCUMENT_METADATA_STRICT=false
EMBEDDING_BATCH_SIZE=50
EMBEDDING_MAX_RETRIES=3
EMBEDDING_TIMEOUT_SECONDS=60
ENABLE_DOCUMENT_INGESTION_API=true
ANALYTICS_DEFAULT_LIMIT=50
ANALYTICS_MAX_LIMIT=200
ANALYTICS_QUERY_TIMEOUT_SECONDS=15
ANALYTICS_MAX_DATE_RANGE_DAYS=366
ANALYTICS_ALLOW_RAW_SQL=false
ANALYTICS_ENABLE_DEBUG_API=true
ANALYTICS_ENABLE_EXPLAIN=false
ENABLE_ANALYTICS_API=true
ENABLE_HYBRID_CHAT_API=true
TRUCK_FUEL_ANOMALY_MULTIPLIER=1.5
TRUCK_DURATION_ANOMALY_MULTIPLIER=1.5
