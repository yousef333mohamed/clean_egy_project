-- Run manually as a PostgreSQL security administrator. Supply passwords out of band.
CREATE ROLE wasteops_app LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOINHERIT;
CREATE ROLE wasteops_analytics LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOINHERIT;
CREATE ROLE wasteops_migrations LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOINHERIT;
CREATE ROLE wasteops_backup LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOINHERIT;
