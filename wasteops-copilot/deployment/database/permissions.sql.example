REVOKE CREATE ON SCHEMA public FROM PUBLIC;
GRANT CONNECT ON DATABASE wasteops TO wasteops_app, wasteops_analytics, wasteops_migrations, wasteops_backup;
GRANT USAGE ON SCHEMA public TO wasteops_app;
GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA public TO wasteops_app;
GRANT USAGE, SELECT ON ALL SEQUENCES IN SCHEMA public TO wasteops_app;
REVOKE UPDATE, DELETE ON audit_events FROM wasteops_app;
GRANT SELECT, INSERT ON audit_events TO wasteops_app;
ALTER DEFAULT PRIVILEGES FOR ROLE wasteops_migrations IN SCHEMA public GRANT SELECT, INSERT, UPDATE, DELETE ON TABLES TO wasteops_app;
ALTER DEFAULT PRIVILEGES FOR ROLE wasteops_migrations IN SCHEMA public GRANT USAGE, SELECT ON SEQUENCES TO wasteops_app;
GRANT USAGE, CREATE ON SCHEMA public TO wasteops_migrations;
GRANT ALL PRIVILEGES ON ALL TABLES IN SCHEMA public TO wasteops_migrations;
GRANT SELECT ON ALL TABLES IN SCHEMA public TO wasteops_backup;
GRANT SELECT ON ALL SEQUENCES IN SCHEMA public TO wasteops_backup;
